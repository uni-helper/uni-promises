{
  "name": "@uni-helper/uni-promises",
  "version": "0.5.1",
  "description": "uni-app Promise 化的 API",
  "keywords": [
    "uni-app",
    "uniapp",
    "uni",
    "promisify",
    "promise",
    "promisified",
    "api"
  ],
  "homepage": "https://github.com/uni-helper/uni-promises#readme",
  "bugs": {
    "url": "https://github.com/uni-helper/uni-promises/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/uni-promises.git"
  },
  "license": "MIT",
  "author": {
    "name": "ModyQyW",
    "email": "wurui.dev@gmail.com",
    "url": "https://modyqyw.github.io"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/types": "^3.4.32"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.4",
    "bumpp": "^12.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.12.4"
  },
  "peerDependencies": {
    "typescript": "^4.8.0 || ^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=14.18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
